{
  "ConnectionStrings": {
    "StudyForgeDb": "Server=(localdb)\\MSSQLLocalDB;Database=StudyForgeDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
