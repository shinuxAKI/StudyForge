<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudyForge</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index"><span class="brand-mark">S</span> StudyForge</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <div class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        @if (Context.Session.GetString("AccessToken") is not null)
                        {
                            <a class="nav-link" asp-controller="Study" asp-action="Index">My workspace</a>
                            <span class="nav-link text-secondary small">Hi, @Context.Session.GetString("DisplayName")</span>
                            <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-secondary btn-sm">Log out</button></form>
                        }
                        else
                        {
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a>
                            <a class="btn btn-primary btn-sm px-3" asp-controller="Account" asp-action="Register">Get started</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <main role="main">@RenderBody()</main>
    <footer class="border-top text-muted py-4 mt-5"><div class="container small d-flex justify-content-between"><span>© @DateTime.Now.Year StudyForge</span><span>Learn with focus. Remember for longer.</span></div></footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
