@model StudyForge.Web.Controllers.LoginViewModel
@{ ViewData["Title"] = "Log in"; }
<div class="auth-wrap"><div class="auth-card"><a asp-controller="Home" asp-action="Index" class="text-decoration-none small">← Back to home</a><h1 class="h2 fw-bold mt-4">Welcome back</h1><p class="text-secondary">Pick up where your learning left off.</p>
<form asp-action="Login" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="mb-3"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control form-control-lg" autocomplete="email" /><span asp-validation-for="Email" class="text-danger small"></span></div>
<div class="mb-4"><label asp-for="Password" class="form-label">Password</label><input asp-for="Password" class="form-control form-control-lg" autocomplete="current-password" /><span asp-validation-for="Password" class="text-danger small"></span></div><button class="btn btn-primary btn-lg w-100">Log in</button></form>
<p class="text-secondary text-center mt-4 mb-0">New to StudyForge? <a asp-action="Register">Create an account</a></p></div></div>
