@model StudyForge.Web.Controllers.RegisterViewModel
@{ ViewData["Title"] = "Create account"; }
<div class="auth-wrap"><div class="auth-card"><a asp-controller="Home" asp-action="Index" class="text-decoration-none small">← Back to home</a><h1 class="h2 fw-bold mt-4">Create your account</h1><p class="text-secondary">Your personal learning space starts here.</p>
<form asp-action="Register" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="mb-3"><label asp-for="DisplayName" class="form-label">Name</label><input asp-for="DisplayName" class="form-control form-control-lg" autocomplete="name" /><span asp-validation-for="DisplayName" class="text-danger small"></span></div>
<div class="mb-3"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control form-control-lg" autocomplete="email" /><span asp-validation-for="Email" class="text-danger small"></span></div>
<div class="mb-4"><label asp-for="Password" class="form-label">Password</label><input asp-for="Password" class="form-control form-control-lg" autocomplete="new-password" /><div class="form-text">At least 8 characters, including uppercase, lowercase and a number.</div><span asp-validation-for="Password" class="text-danger small"></span></div><button class="btn btn-primary btn-lg w-100">Create account</button></form>
<p class="text-secondary text-center mt-4 mb-0">Already registered? <a asp-action="Login">Log in</a></p></div></div>
