@model IReadOnlyList<StudyForge.Web.Services.SubjectSummary>
@{ ViewData["Title"] = "My workspace"; }
<div class="container py-5"><div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><span class="eyebrow">YOUR LEARNING SPACE</span><h1 class="fw-bold mt-2">Welcome, @ViewBag.DisplayName</h1><p class="text-secondary mb-0">Start with a subject, then add the material you want to master.</p></div></div>
@if (ViewBag.Error is not null) { <div class="alert alert-warning">@ViewBag.Error</div> } @if (TempData["Error"] is not null) { <div class="alert alert-danger">@TempData["Error"]</div> }
<div class="row g-4"><div class="col-lg-4"><div class="feature-card"><h5 class="fw-bold">Add a subject</h5><p class="text-secondary small">For example: Biology, Mathematics, or History.</p>
<form asp-action="CreateSubject" method="post"><div class="mb-3"><label class="form-label" for="name">Subject name</label><input class="form-control" id="name" name="name" maxlength="100" required /></div><div class="mb-3"><label class="form-label" for="description">Description <span class="text-secondary">(optional)</span></label><textarea class="form-control" id="description" name="description" rows="3" maxlength="500"></textarea></div><button class="btn btn-primary w-100">Create subject</button></form></div></div>
<div class="col-lg-8"><div class="feature-card h-100"><div class="d-flex justify-content-between align-items-center mb-3"><h5 class="fw-bold mb-0">Your subjects</h5><span class="badge text-bg-light">@Model.Count total</span></div>
@if (Model.Count == 0) { <div class="empty-state"><div class="feature-icon mx-auto mb-3">＋</div><h6>No subjects yet</h6><p class="text-secondary mb-0">Create your first subject to get started.</p></div> } else { <div class="list-group list-group-flush">@foreach (var subject in Model) { <div class="list-group-item px-0 py-3"><div class="fw-semibold">@subject.Name</div><div class="small text-secondary">@(string.IsNullOrWhiteSpace(subject.Description) ? "No description yet" : subject.Description)</div></div> }</div> }</div></div></div></div>
